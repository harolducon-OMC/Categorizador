# Copia este archivo como .streamlit/secrets.toml (local) o pega los valores
# en Streamlit Cloud > App > Settings > Secrets. NUNCA subas secrets.toml a GitHub.
# La app requiere un par APP_USERNAME / APP_PASSWORD antes de abrirse.
# Descomenta y reemplaza estos textos por credenciales privadas y únicas.
# APP_USERNAME = "elige-tu-usuario"
# APP_PASSWORD = "reemplaza-por-una-clave-larga-y-unica"

# Configura solo las claves de IA que realmente usarás.
# Google AI Studio / Gemini: GEMINI_API_KEY = "tu-clave"
# Groq: GROQ_API_KEY = "tu-clave"
# Cohere: COHERE_API_KEY = "tu-clave"
# OpenRouter: OPENROUTER_API_KEY = "tu-clave"
# Anthropic / Claude: ANTHROPIC_API_KEY = "tu-clave"

# Opcional: modelo inicial predeterminado para Anthropic.
# MODEL_FAST = "claude-haiku-5-5"
